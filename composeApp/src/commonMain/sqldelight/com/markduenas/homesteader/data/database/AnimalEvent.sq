-- Animal Event table for tracking all events related to animals
CREATE TABLE AnimalEventEntity (
    id TEXT NOT NULL PRIMARY KEY,
    animal_id TEXT NOT NULL,
    event_type TEXT NOT NULL,
    event_date TEXT NOT NULL,
    notes TEXT,
    event_data TEXT,  -- JSON containing type-specific data
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    FOREIGN KEY (animal_id) REFERENCES AnimalEntity(id) ON DELETE CASCADE
);

-- Indexes for common queries
CREATE INDEX event_animal_idx ON AnimalEventEntity(animal_id);
CREATE INDEX event_type_idx ON AnimalEventEntity(event_type);
CREATE INDEX event_date_idx ON AnimalEventEntity(event_date);

-- Get all events for an animal (timeline)
selectByAnimalId:
SELECT *
FROM AnimalEventEntity
WHERE animal_id = ?
ORDER BY event_date DESC, created_at DESC;

-- Get all events by type
selectByType:
SELECT *
FROM AnimalEventEntity
WHERE event_type = ?
ORDER BY event_date DESC;

-- Get all events by type for an animal
selectByAnimalAndType:
SELECT *
FROM AnimalEventEntity
WHERE animal_id = ? AND event_type = ?
ORDER BY event_date DESC;

-- Get event by ID
selectById:
SELECT *
FROM AnimalEventEntity
WHERE id = ?;

-- Get recent events across all animals
selectRecent:
SELECT *
FROM AnimalEventEntity
ORDER BY event_date DESC, created_at DESC
LIMIT ?;

-- Get events within date range
selectByDateRange:
SELECT *
FROM AnimalEventEntity
WHERE event_date >= ? AND event_date <= ?
ORDER BY event_date DESC;

-- Get events within date range for an animal
selectByAnimalAndDateRange:
SELECT *
FROM AnimalEventEntity
WHERE animal_id = ? AND event_date >= ? AND event_date <= ?
ORDER BY event_date DESC;

-- Get latest event of a type for an animal (useful for breeding cycles, etc.)
selectLatestByAnimalAndType:
SELECT *
FROM AnimalEventEntity
WHERE animal_id = ? AND event_type = ?
ORDER BY event_date DESC
LIMIT 1;

-- Count events by type for an animal
countByAnimalAndType:
SELECT COUNT(*)
FROM AnimalEventEntity
WHERE animal_id = ? AND event_type = ?;

-- Count all events for an animal
countByAnimal:
SELECT COUNT(*)
FROM AnimalEventEntity
WHERE animal_id = ?;

-- Get breeding events for an animal (heat, bred, pregnancy check, birth)
selectBreedingEvents:
SELECT *
FROM AnimalEventEntity
WHERE animal_id = ? AND event_type IN ('HEAT_OBSERVED', 'BRED', 'PREGNANCY_CHECK', 'BIRTH', 'WEANING')
ORDER BY event_date DESC;

-- Get health events for an animal
selectHealthEvents:
SELECT *
FROM AnimalEventEntity
WHERE animal_id = ? AND event_type IN ('VACCINATION', 'TREATMENT', 'VET_VISIT', 'ILLNESS', 'INJURY', 'DEWORMING', 'HOOF_TRIM')
ORDER BY event_date DESC;

-- Get production events for an animal
selectProductionEvents:
SELECT *
FROM AnimalEventEntity
WHERE animal_id = ? AND event_type IN ('MILK_RECORD', 'EGG_COLLECTION', 'SHEARING')
ORDER BY event_date DESC;

-- Get weight events for an animal
selectWeightEvents:
SELECT *
FROM AnimalEventEntity
WHERE animal_id = ? AND event_type = 'WEIGHT_RECORD'
ORDER BY event_date DESC;

-- Insert new event
insert:
INSERT INTO AnimalEventEntity(
    id, animal_id, event_type, event_date, notes, event_data, created_at, updated_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- Update event
update:
UPDATE AnimalEventEntity
SET event_type = ?,
    event_date = ?,
    notes = ?,
    event_data = ?,
    updated_at = ?
WHERE id = ?;

-- Delete event
delete:
DELETE FROM AnimalEventEntity
WHERE id = ?;

-- Delete all events for an animal
deleteByAnimal:
DELETE FROM AnimalEventEntity
WHERE animal_id = ?;

-- Delete all events (for testing/reset)
deleteAll:
DELETE FROM AnimalEventEntity;
